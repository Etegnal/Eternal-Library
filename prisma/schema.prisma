generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PostType {
  YAZI
  SIIR
}

model User {
  id            String       @id @default(uuid())
  name          String?
  email         String       @unique
  password      String       @default("")
  role          Role         @default(USER)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  likeRecords   LikeRecord[]
  savedBooks    SavedBook[]
  viewRecords   ViewRecord[]
}

model Post {
  id          String       @id @default(uuid())
  title       String
  slug        String       @unique
  content     String
  excerpt     String
  type        PostType     @default(YAZI)
  author      String?
  coverImage  String?
  readingTime String?
  isFeatured  Boolean      @default(true)
  likes       Int          @default(0)
  views       Int          @default(0)
  publishedAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  likeRecords LikeRecord[]
  viewRecords ViewRecord[]
}

model ViewRecord {
  id        String   @id @default(uuid())
  postId    String
  userId    String?
  userEmail String?
  userName  String?
  postTitle String?
  postType  PostType @default(YAZI)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  post Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model LikeRecord {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Quote {
  id        String   @id @default(uuid())
  author    String
  content   String
  source    String?
  dayOfYear Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Book {
  id            String      @id @default(uuid())
  slug          String      @unique @default(uuid())
  title         String      @default("")
  author        String      @default("")
  year          Int         @default(0)
  pages         Int         @default(0)
  category      String      @default("Klasikler")
  summary       String      @db.Text @default("")
  rating        Float       @default(4.8)
  isReadable    Boolean     @default(false)
  coverUrl      String      @default("")
  buyUrl        String?     @default("")
  googleBookId  String?
  authors       String?
  description   String?
  thumbnailUrl  String?
  largeCoverUrl String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  bookPages     BookPage[]
  savedBooks    SavedBook[]
}

model SavedBook {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, bookId])
}

model BookPage {
  id         String   @id @default(uuid())
  bookId     String
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageNumber Int
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@unique([bookId, pageNumber])
}

model Letter {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  content   String
  type      String   @default("MEKTUP")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MasterPoet {
  id        String   @id @default(uuid())
  author    String
  title     String
  slug      String   @default("")
  excerpt   String
  content   String   @default("")
  year      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Track {
  id         String   @id @default(uuid())
  title      String
  artist     String
  src        String
  cover      String?
  spotifyUrl String   @default("https://open.spotify.com")
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PsychologicalTest {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  description String         @db.Text
  coverImage  String?
  category    String?        @default("Psikolojik Test")
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  questions   TestQuestion[]
}

model TestQuestion {
  id           String            @id @default(uuid())
  testId       String
  test         PsychologicalTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionText String            @db.Text
  order        Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  options      TestOption[]
}

model TestOption {
  id                  String       @id @default(uuid())
  questionId          String
  question            TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText          String       @db.Text
  metaphorExplanation String       @db.Text
  order               Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}
