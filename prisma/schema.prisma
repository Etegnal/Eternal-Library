generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PostType {
  YAZI
  SIIR
}

model User {
  id            String       @id @default(uuid())
  name          String?
  email         String       @unique
  password      String       @default("")
  role          Role         @default(USER)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  likeRecords   LikeRecord[]
}

model Post {
  id          String       @id @default(uuid())
  title       String
  slug        String       @unique
  content     String
  excerpt     String
  type        PostType     @default(YAZI)
  coverImage  String?
  readingTime String?
  isFeatured  Boolean      @default(true)
  likes       Int          @default(0)
  views       Int          @default(0)
  publishedAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  likeRecords LikeRecord[]
}

model LikeRecord {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Quote {
  id        String   @id @default(uuid())
  author    String
  content   String
  source    String?
  dayOfYear Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Book {
  id              String   @id @default(uuid())
  googleBookId    String?  @unique
  isbn10          String?
  isbn13          String?
  title           String
  subtitle        String?
  authors         String   // JSON string veya virgülle ayrılmış yazar listesi
  publisher       String?
  publishedDate   String?
  description     String?  // Uzun özet metni
  pageCount       Int?
  categories      String   // Kategori listesi
  averageRating   Float?   @default(0)
  ratingsCount    Int?     @default(0)
  thumbnailUrl    String?
  largeCoverUrl   String?
  previewUrl      String?
  isFeatured      Boolean  @default(false)
  curatedCategory String?  // "Felsefe & Düşünce", "Dünya Klasikleri", "Şiir & Edebiyat" vb.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  affiliateClicks AffiliateClick[]
}

model AffiliateClick {
  id        String   @id @default(uuid())
  bookId    String
  platform  String   // "amazon", "kitapyurdu", "dr"
  ipAddress String?
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Letter {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  content   String
  type      String   @default("MEKTUP")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
